{
  "manifest_version": 3,
  "name": "魔王S腾讯文档同步助手",
  "version": "9.0.6",
  "description": "从腾讯文档同步魔王S改枪码：Protobuf叶子序列语义解析，按游戏模式分层存储",
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://docs.qq.com/*",
    "http://localhost:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "魔王S腾讯文档同步助手（在腾讯表格页点击）"
  }
}